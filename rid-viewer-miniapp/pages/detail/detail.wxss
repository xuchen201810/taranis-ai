.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 28rpx 28rpx 60rpx;
}

.hero {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 30rpx 26rpx;
}

.dot {
  font-size: 34rpx;
  margin-right: 18rpx;
}

.hero-text {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.title {
  font-size: 34rpx;
  font-weight: 700;
  color: #E6F1FF;
  word-break: break-all;
}

.status {
  font-size: 24rpx;
  color: #7A8CA3;
  margin-top: 8rpx;
}

.info {
  margin-top: 22rpx;
  padding: 8rpx 26rpx;
}

.line {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: flex-start;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #1A2740;
}

.line:last-child {
  border-bottom: none;
}

.k {
  font-size: 24rpx;
  color: #7A8CA3;
  flex: none;
  margin-right: 24rpx;
}

.v {
  font-size: 26rpx;
  color: #E6F1FF;
  text-align: right;
  word-break: break-all;
}

.no-data {
  font-size: 24rpx;
  color: #7A8CA3;
  padding: 30rpx 0;
  text-align: center;
}

.note {
  display: block;
  margin-top: 26rpx;
  padding: 0 6rpx;
  font-size: 20rpx;
  color: #4E6076;
  line-height: 1.6;
}
