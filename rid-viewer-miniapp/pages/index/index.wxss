.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
  padding: 20rpx 24rpx 24rpx;
}

.header {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.titles {
  display: flex;
  flex-direction: column;
}

.title {
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: #E6F1FF;
}

.status-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-top: 4rpx;
}

.live-dot {
  font-size: 18rpx;
  margin-right: 8rpx;
}

.status {
  font-size: 22rpx;
  color: #7A8CA3;
}

.pill {
  padding: 12rpx 26rpx;
  border-radius: 40rpx;
  background: #1B2942;
  border: 1rpx solid #1E2B42;
  color: #22D3EE;
  font-size: 24rpx;
}

.pill.ghost {
  color: #7A8CA3;
  margin-left: 16rpx;
}

.room-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-top: 18rpx;
}

.room {
  flex: 1;
  height: 64rpx;
  background: #121C2E;
  border: 1rpx solid #1E2B42;
  border-radius: 16rpx;
  padding: 0 20rpx;
  font-size: 24rpx;
  color: #E6F1FF;
}

.ph {
  color: #5C7089;
}

.radar-wrap {
  margin-top: 18rpx;
  height: 620rpx;
  position: relative;
  padding: 10rpx;
  box-sizing: border-box;
}

.radar {
  width: 100%;
  height: 100%;
}

.hint {
  position: absolute;
  bottom: 12rpx;
  left: 0;
  right: 0;
  text-align: center;
  font-size: 20rpx;
  color: #5C7089;
}

.list {
  flex: 1;
  height: 0;
  margin-top: 18rpx;
}

.row {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 22rpx;
  margin-bottom: 14rpx;
}

.dot {
  font-size: 30rpx;
  margin-right: 16rpx;
}

.info {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.id {
  font-size: 28rpx;
  font-weight: 600;
  color: #E6F1FF;
}

.sub {
  font-size: 22rpx;
  color: #7A8CA3;
  margin-top: 6rpx;
}

.right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  margin-left: 12rpx;
}

.dist {
  font-size: 28rpx;
  font-weight: 600;
  color: #22D3EE;
}

.meta {
  font-size: 20rpx;
  color: #7A8CA3;
  margin-top: 6rpx;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0;
}

.empty-title {
  font-size: 26rpx;
  color: #7A8CA3;
}

.empty-sub {
  font-size: 22rpx;
  color: #5C7089;
  margin-top: 10rpx;
}

.footer {
  font-size: 20rpx;
  color: #4E6076;
  line-height: 1.6;
  padding: 20rpx 8rpx 40rpx;
}
